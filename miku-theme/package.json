{
  "name": "miku-langua",
  "publisher": "miku",
  "displayName": "Miku Language",
  "description": "Syntax support for Miku language",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "miku",
        "aliases": ["Miku", "miku"],
        "extensions": [".miku"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "miku",
        "scopeName": "source.miku",
        "path": "./syntaxes/miku.tmLanguage.json"
      }
    ]
  }
}
